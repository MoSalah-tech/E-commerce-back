# ---------------------------------------------------------------------------
# Copy this file to .env and replace every CHANGE_ME placeholder with a real
# value. .env is git-ignored and must never be committed.
#
# Passwords must satisfy the SQL Server password policy: upper case, lower
# case, digit and symbol, at least 8 characters.
# ---------------------------------------------------------------------------

# --- SQL Server container ---------------------------------------------------
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!Sa
MSSQL_USER=ecommerce_app
MSSQL_PASSWORD=CHANGE_ME_Str0ng!App
MSSQL_DATABASE=ECommerceDb
MSSQL_HOST_PORT=1433

# --- API configuration ------------------------------------------------------
# Consumed by docker-compose.yml and injected into the api container as
# environment variables, which take precedence over user-secrets and appsettings.
Jwt__Issuer=ECommerce.Api
Jwt__Audience=ECommerce.Clients
Jwt__SigningKey=CHANGE_ME_at_least_32_random_characters_for_hmac_sha256
Jwt__ExpiryMinutes=60