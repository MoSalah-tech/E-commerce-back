{
  "Jwt": {
    "Issuer": "ECommerce.Api",
    "Audience": "ECommerce.Clients",
    "ExpiryMinutes": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}